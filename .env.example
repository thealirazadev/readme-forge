# Copy this file to .env and fill in real values. Never commit your real .env.

# Required. Your Anthropic API key. Used to call the Claude API to draft the README.
ANTHROPIC_API_KEY=sk-ant-000000000000000000000000000000000000

# Optional. Overrides the default Claude model id used to draft the README.
# Leave unset to use the built-in default. The --model flag overrides this too.
README_FORGE_MODEL=claude-sonnet-5-5
